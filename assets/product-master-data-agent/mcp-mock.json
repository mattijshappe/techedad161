          "mock_response": {
            "results": [
              {
                "Product": "P-100",
                "ProductType": "FERT",
                "BaseUnit": "EA",
                "ProductGroup": "L001",
                "Division": "00",
                "GrossWeight": "1.500",
                "NetWeight": "1.200",
                "WeightUnit": "KG",
                "ProductDescription": "Industrial Pump Model A",
